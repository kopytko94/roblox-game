local MAX_PRESTIGE = 20

RE_doPrestige.OnServerEvent:Connect(function(player)
	local data = playerData[player.UserId]
	if not data then return end
	if data._prestiging then return end
	if data.prestige >= MAX_PRESTIGE then return end
	local required = 1000000 * (10 ^ data.prestige)
	if data.totalClicks < required then return end
	data._prestiging = true

	local spMagnetLv = data.spUpgrades["sp_mult1"] or 0
	local spMultiplier = 1 + (spMagnetLv * 0.20)
	local baseSP = math.floor(data.prestige / 3) + 1
	local spEarned = math.max(1, math.floor(baseSP * spMultiplier))
	data.starPoints = (data.starPoints or 0) + spEarned
	data.totalSPEarned = (data.totalSPEarned or 0) + spEarned
	data.lastSPEarned = spEarned

	data.prestige    += 1
	data.clicks       = 0
	data.totalClicks  = 0
	for _, def in ipairs(UPGRADES) do
		data.upgrades[def.id] = 0
	end
	-- petCounts, inventory, equippedSkin are NOT reset on prestige
	data._prestiging = nil
	recalculateStats(data)
	checkAchievements(data, player)
	syncPlayer(player)
end)

RE_rollEgg.OnServerEvent:Connect(function(player, eggNum)
	local data = playerData[player.UserId]
	if not data then return end

	local function fireRollFail(reason, payloadEggNum, requiredClicks)
		RE_rollEgg:FireClient(player, {
			ok = false,
			eggNum = payloadEggNum,
			reason = reason or "INTERNAL_ERROR",
			requiredClicks = math.max(0, math.floor(asNumber(requiredClicks) or 0)),
			currentClicks = math.max(0, math.floor(asNumber(data.clicks) or 0)),
		})
	end

	local parsedEggNum = asNumber(eggNum)
	if not parsedEggNum or parsedEggNum ~= math.floor(parsedEggNum) then
		fireRollFail("INVALID_EGG", nil, 0); return
	end
	parsedEggNum = math.floor(parsedEggNum)
	if parsedEggNum < 1 or parsedEggNum > 3 then
		fireRollFail("INVALID_EGG", parsedEggNum, 0); return
	end

	local cost = getEffectiveEggCost(data, parsedEggNum)
	if not cost then fireRollFail("INTERNAL_ERROR", parsedEggNum, 0); return end
	if data.clicks < cost then fireRollFail("INSUFFICIENT_CLICKS", parsedEggNum, cost); return end

	local ok, err = pcall(function()
		data.clicks -= cost

		local pityLeg, pityMythic = getPityTables(data)
		local legPity = pityLeg[parsedEggNum] or 0
		local mythPity = pityMythic[parsedEggNum] or 0

		local pet
		if mythPity >= 100 then
			pet = rollPetByRarities(parsedEggNum, { Mythic = true })
		elseif legPity >= 30 then
			pet = rollPetByRarities(parsedEggNum, { Legendary = true, Mythic = true })
		else
			pet = rollPet(parsedEggNum)
		end
		if not pet then error("rollPet returned nil") end

		data.petCounts = data.petCounts or {}
		local isDuplicate = hasInInventory(data, pet.id)
		local bonusClicks = 0

		if pet.rarity == "Mythic" then
			pityLeg[parsedEggNum] = 0
			pityMythic[parsedEggNum] = 0
		elseif pet.rarity == "Legendary" then
			pityLeg[parsedEggNum] = 0
			pityMythic[parsedEggNum] = (mythPity or 0) + 1
		else
			pityLeg[parsedEggNum] = (legPity or 0) + 1
			pityMythic[parsedEggNum] = (mythPity or 0) + 1
		end

		if not isDuplicate then
			table.insert(data.inventory, pet.id)
			data.petCounts[pet.id] = 1
		else
			data.petCounts[pet.id] = (data.petCounts[pet.id] or 1) + 1
		end

		recalculateStats(data)
		checkAchievements(data, player)
		syncPlayer(player)

		RE_rollEgg:FireClient(player, {
			ok = true,
			eggNum = parsedEggNum,
			petId = pet.id,
			rarity = pet.rarity,
			multiplier = pet.multiplier,
			isDuplicate = isDuplicate,
			bonusClicks = bonusClicks,
			cost = cost,
		})
	end)

	if not ok then
		warn("RollEgg failed for " .. player.Name .. ": " .. tostring(err))
		fireRollFail("INTERNAL_ERROR", parsedEggNum, cost)
	end
end)

