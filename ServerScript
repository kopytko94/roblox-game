RE_craftGolden.OnServerEvent:Connect(function(player, petId)
	local data = playerData[player.UserId]
	if not data then return end
	if type(petId) ~= "string" then return end
	if isGoldenPet(petId) then return end                           -- no golden-of-golden

	local baseDef = getPetDef(petId)
	if not baseDef and petId ~= "dog" then return end              -- unknown pet

	data.petCounts = data.petCounts or {}
	local count = data.petCounts[petId] or 0
	if count < 5 then return end                                   -- need 5 copies

	local goldenId = "golden_" .. petId
	-- Consume 5 copies
	data.petCounts[petId] = count - 5
	if data.petCounts[petId] <= 0 then
		data.petCounts[petId] = nil
		-- Remove from unique inventory array
		for i = #data.inventory, 1, -1 do
			if data.inventory[i] == petId then
				table.remove(data.inventory, i)
				break
			end
		end
		-- Auto-equip the new golden pet if the base one was equipped
		if data.equippedSkin == petId then
			data.equippedSkin = goldenId
		end
	end

	-- Add golden version
	data.petCounts[goldenId] = (data.petCounts[goldenId] or 0) + 1
	if not hasInInventory(data, goldenId) then
		table.insert(data.inventory, goldenId)
	end

	recalculateStats(data)
	checkAchievements(data, player)
	syncPlayer(player)
end)

