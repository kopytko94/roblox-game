local function checkAchievements(data, player)
	local newlyUnlocked = {}

	for _, ach in ipairs(ACHIEVEMENTS) do
		if not data.achievements[ach.id] then
			local unlocked = false

			if ach.req_lifetime and (data.lifetimeClicks or 0) >= ach.req_lifetime then unlocked = true end
			if ach.req_owned    and data.clicks >= ach.req_owned                   then unlocked = true end
			if ach.req_prestige and data.prestige   >= ach.req_prestige then unlocked = true end
			if ach.req_sp      and (data.totalSPEarned or 0) >= ach.req_sp then unlocked = true end
			if ach.req_streak  and (data.dailyStreak or 0) >= ach.req_streak then unlocked = true end

			if ach.req_pets then
				local petCount = #data.inventory - 1
				if petCount >= ach.req_pets then unlocked = true end
			end

			-- Golden pets count as Legendary+ for achievement purposes
			if ach.req_legendary then
				for _, petId in ipairs(data.inventory) do
					if isGoldenPet(petId) then
						unlocked = true; break
					end
					local def = getPetDef(petId)
					local rarity = def and def.rarity or "Default"
					if rarity == "Legendary" or rarity == "Mythic" then
						unlocked = true; break
					end
				end
			end

			-- Golden pets count as Mythic for achievement purposes
			if ach.req_mythic then
				for _, petId in ipairs(data.inventory) do
					if isGoldenPet(petId) then unlocked = true; break end
					local def = getPetDef(petId)
					if def and def.rarity == "Mythic" then unlocked = true; break end
				end
			end

			if ach.req_any_max then
				local UPGRADES_MAX = {
					better_finger=50, auto_clicker=30, double_click=20,
					click_farm=20, multiplier_boost=10, mega_clicker=15, robot_army=15,
				}
				for id, maxLv in pairs(UPGRADES_MAX) do
					if (data.upgrades[id] or 0) >= maxLv then unlocked = true break end
				end
			end

			if unlocked then
				data.achievements[ach.id] = true
				table.insert(newlyUnlocked, ach)
			end
		end
	end

	if #newlyUnlocked > 0 then
		recalculateStats(data)
		data.newAchievements = newlyUnlocked
	end
end

local function normalizeDailyProgress(data, now)
	now = now or os.time()

	data.dailyRewardDay = math.clamp(math.floor(asNumber(data.dailyRewardDay) or 1), 1, 7)
	data.dailyStreak = math.max(0, math.floor(asNumber(data.dailyStreak) or 0))
	data.dailySessionSeconds = math.max(0, math.min(DAILY_SESSION_REQ, math.floor(asNumber(data.dailySessionSeconds) or 0)))

	data.dailyNextClaimTime = math.max(0, asNumber(data.dailyNextClaimTime) or 0)

	if data.dailyRewardDay > 1 then
		local lateBy = now - data.dailyNextClaimTime
		if lateBy > DAILY_MISS_RESET_WINDOW then
			data.dailyRewardDay = 1
			data.dailyStreak = 0
			data.dailySessionSeconds = 0
			data.dailyNextClaimTime = 0
		end
	end
end

local MAX_PRESTIGE = 20
local PRESTIGE_BASE_REQ = 1000000

local function fmtGoal(n)
	n = math.floor(asNumber(n) or 0)
	if n >= 1e12 then return string.format("%.2fT", n/1e12)
	elseif n >= 1e9 then return string.format("%.2fB", n/1e9)
	elseif n >= 1e6 then return string.format("%.2fM", n/1e6)
	elseif n >= 1e3 then return string.format("%.1fK", n/1e3)
	else return tostring(n) end
end

local function getPrestigeRequirement(prestige)
	return PRESTIGE_BASE_REQ * (10 ^ math.max(0, prestige or 0))
end

local function getUpgradeScore(upg)
	return math.max((upg.cpc or 0) * 1.0 + (upg.cps or 0) * 1.45 + (upg.mult or 0) * 7.5, 1)
end

local function prettifyId(id)
	local s = tostring(id or ""):gsub("_", " ")
	return (s:gsub("^%l", string.upper))
end

local function getNextGoalSnapshot(data)
	local clicks = math.max(0, math.floor(asNumber(data.clicks) or 0))
	local totalClicks = math.max(0, math.floor(asNumber(data.totalClicks) or 0))
	local prestige = math.max(0, math.floor(asNumber(data.prestige) or 0))
	local presReq = getPrestigeRequirement(prestige)
	local isMaxPrestige = prestige >= MAX_PRESTIGE
	local canPrestige = (not isMaxPrestige) and totalClicks >= presReq
	local prestigeProgress = (isMaxPrestige and 1) or math.clamp(totalClicks / presReq, 0, 1)
	local prestigeAway = math.max(0, presReq - totalClicks)
	local prestigeSoon = (not isMaxPrestige) and prestigeProgress >= 0.85

	local bestAffordable, bestSoonest
	for _, upg in ipairs(UPGRADES) do
		local lv = data.upgrades[upg.id] or 0
		if lv < upg.maxLevel then
			local cost = getUpgradeCost(upg.id, lv)
			local progress = (cost > 0) and math.clamp(clicks / cost, 0, 1) or 0
			local score = getUpgradeScore(upg)
			local cand = {
				type = "UPGRADE",
				name = prettifyId(upg.id),
				cost = cost,
				progress = progress,
				away = fmtGoal(math.max(0, cost - clicks)) .. " clicks away",
				detail = string.format("+%.1f value | Lv %d/%d", score, lv, upg.maxLevel),
				score = score,
				canAfford = cost <= clicks,
			}
			if not bestSoonest or cost < bestSoonest.cost or (cost == bestSoonest.cost and progress > bestSoonest.progress) then
				bestSoonest = cand
			end
			if cand.canAfford and (not bestAffordable or cand.score > bestAffordable.score or (cand.score == bestAffordable.score and cand.cost < bestAffordable.cost)) then
				bestAffordable = cand
			end
		end
	end

	local pitLeg = data.pityLeg or {0,0,0}
	local pitMyth = data.pityMythic or {0,0,0}
	local pityGoal
	for eggNum = 1, 3 do
		local l = math.max(0, math.floor(asNumber(pitLeg[eggNum]) or 0))
		local m = math.max(0, math.floor(asNumber(pitMyth[eggNum]) or 0))
		local legRemaining = math.max(0, 30 - l)
		local mythRemaining = math.max(0, 100 - m)
		if legRemaining <= 10 and (not pityGoal or legRemaining < pityGoal.remaining) then
			pityGoal = { type = "PITY", name = string.format("Hatch Egg %d", eggNum), progress = math.clamp(l / 30, 0, 1), away = string.format("%d hatch%s away", legRemaining, legRemaining == 1 and "" or "es"), detail = string.format("Egg %d • Legendary pity %d/30", eggNum, l), score = 100 - legRemaining, remaining = legRemaining }
		end
		if mythRemaining <= 20 and (not pityGoal or mythRemaining < pityGoal.remaining) then
			pityGoal = { type = "PITY", name = string.format("Hatch Egg %d", eggNum), progress = math.clamp(m / 100, 0, 1), away = string.format("%d hatch%s away", mythRemaining, mythRemaining == 1 and "" or "es"), detail = string.format("Egg %d • Mythic pity %d/100", eggNum, m), score = 100 - mythRemaining, remaining = mythRemaining }
		end
	end

	local goal
	if canPrestige then
		goal = { type = "PRESTIGE", name = "Prestige " .. (prestige + 1), progress = 1, away = "Ready to cash out now", detail = string.format("Spend %s total clicks for %d SP", fmtGoal(presReq), math.max(1, math.floor(prestige / 3) + 1)), score = 999 }
	elseif prestigeSoon then
		goal = { type = "PRESTIGE", name = "Prestige " .. (prestige + 1), progress = prestigeProgress, away = fmtGoal(prestigeAway) .. " total clicks away", detail = string.format("Cash out for +%d SP", math.max(1, math.floor(prestige / 3) + 1)), score = prestigeProgress + 0.5 }
	elseif bestAffordable then
		goal = bestAffordable
	elseif pityGoal and (not bestSoonest or pityGoal.progress >= math.max(0.5, bestSoonest.progress - 0.15)) then
		goal = pityGoal
	else
		goal = bestSoonest or { type = "PRESTIGE", name = "Prestige " .. (prestige + 1), progress = prestigeProgress, away = fmtGoal(prestigeAway) .. " total clicks away", detail = string.format("Cash out for +%d SP", math.max(1, math.floor(prestige / 3) + 1)), score = prestigeProgress }
	end

	if goal and goal.type == "UPGRADE" and pityGoal then
		goal.detail = goal.detail .. " | " .. pityGoal.detail
	elseif goal and goal.type == "PRESTIGE" and pityGoal then
		goal.detail = goal.detail .. " | " .. pityGoal.detail
	end

	return goal
end

local function syncPlayer(player)
	local data = playerData[player.UserId]
	if data then
		local now = os.time()
		local is24h = now < (data.dailyNextClaimTime or 0)
		local secsRemaining = 0
		if is24h then
			secsRemaining = math.max(0, math.floor(data.dailyNextClaimTime - now))
		else
			local sessionDone = data.dailySessionSeconds or 0
			secsRemaining = math.max(0, DAILY_SESSION_REQ - sessionDone)
		end
		data.dailySecondsRemaining = secsRemaining
		data.dailyIs24hPhase       = is24h
		data.dailySessionSecsLeft  = math.max(0, DAILY_SESSION_REQ - (data.dailySessionSeconds or 0))
		getPityTables(data)
		data.nextGoal = getNextGoalSnapshot(data)
		RE_syncData:FireClient(player, data)
		data.lastSPEarned       = 0
		data.newAchievements    = {}
		data.pendingDailyReward = nil
	end
end

