local function getPetDef(id)
	for _, p in ipairs(PETS) do
		if p.id == id then return p end
	end
end

local function getUpgradeDef(id)
	for _, u in ipairs(UPGRADES) do
		if u.id == id then return u end
	end
end

local function getUpgradeCost(id, level)
	local def = getUpgradeDef(id)
	if not def then return math.huge end
	return math.floor(def.baseCost * (def.costMult ^ level))
end

local function getSkinMultiplier(skinId)
	if skinId == "dog" or not skinId then return 1.0 end
	-- Golden pet: multiplier = base pet * 2
	if isGoldenPet(skinId) then
		local baseId = getGoldenBasePetId(skinId)
		if baseId then
			if baseId == "dog" then return 2.0 end
			local def = getPetDef(baseId)
			if def then return def.multiplier * 2 end
		end
		return 1.0
	end
	local def = getPetDef(skinId)
	return def and def.multiplier or 1.0
end

local function hasInInventory(data, petId)
	for _, id in ipairs(data.inventory) do
		if id == petId then return true end
	end
	return false
end

local function getPityTables(data)
	data.pityLeg = type(data.pityLeg) == "table" and data.pityLeg or {0,0,0}
	data.pityMythic = type(data.pityMythic) == "table" and data.pityMythic or {0,0,0}
	for i = 1, 3 do
		data.pityLeg[i] = math.max(0, math.floor(asNumber(data.pityLeg[i]) or 0))
		data.pityMythic[i] = math.max(0, math.floor(asNumber(data.pityMythic[i]) or 0))
	end
	return data.pityLeg, data.pityMythic
end

local function rollPet(eggNum)
	local pool = {}
	local total = 0
	for _, p in ipairs(PETS) do
		if p.egg == eggNum then
			table.insert(pool, p)
			total += p.chance
		end
	end
	local roll = math.random(1, total)
	local cum  = 0
	for _, p in ipairs(pool) do
		cum += p.chance
		if roll <= cum then return p end
	end
	return pool[1]
end

local function rollPetByRarities(eggNum, raritySet)
	local pool = {}
	local total = 0
	for _, p in ipairs(PETS) do
		if p.egg == eggNum and raritySet[p.rarity] then
			table.insert(pool, p)
			total += p.chance
		end
	end
	if #pool == 0 then
		return rollPet(eggNum)
	end
	local roll = math.random(1, total)
	local cum = 0
	for _, p in ipairs(pool) do
		cum += p.chance
		if roll <= cum then return p end
	end
	return pool[#pool]
end


local function recalculateStats(data)
	local cpc  = 1
	local cps  = 0
	local mult = 1

	local sp = data.starPoints or 0
	local spBonus = 1 + sp * 0.08

	for _, def in ipairs(UPGRADES) do
		local lv = data.upgrades[def.id] or 0
		cpc += def.cpc * lv
		cps += def.cps * lv
		if def.mult > 0 then
			mult += def.mult * 0.5 * lv
		end
	end

	local sp_cpc_bonus = 1
	local sp_cps_bonus = 1
	local sp_all_bonus = 1
	data.eggDiscount = 0
	data.critChance  = 0
	data.dupBonus    = 0.15

	for _, def in ipairs(SP_UPGRADES) do
		local lv = data.spUpgrades[def.id] or 0
		if lv > 0 then
			if def.cpc_pct then sp_cpc_bonus += def.cpc_pct * lv end
			if def.cps_pct then sp_cps_bonus += def.cps_pct * lv end
			if def.all_mult then sp_all_bonus += def.all_mult * lv end
			if def.egg_disc then data.eggDiscount += def.egg_disc * lv end
			if def.crit_pct then data.critChance  += def.crit_pct * lv end
			if def.dup_pct  then data.dupBonus    = (data.dupBonus or 0) + def.dup_pct * lv end
		end
	end

	local skinMult = getSkinMultiplier(data.equippedSkin)

	local ach_cpc = 1
	local ach_cps = 1
	local ach_all = 1
	data.achSpBonus = 1
	if data.claimedAchievements then
		for _, ach in ipairs(ACHIEVEMENTS) do
			if data.claimedAchievements[ach.id] then
				if ach.reward_type == "cpc" then ach_cpc += ach.reward_val end
				if ach.reward_type == "cps" then ach_cps += ach.reward_val end
				if ach.reward_type == "all" then ach_all += ach.reward_val end
				if ach.reward_type == "sp"  then data.achSpBonus += ach.reward_val end
			end
		end
	end

	data.clicksPerClick  = math.max(1, cpc) * spBonus * mult * sp_cpc_bonus * sp_all_bonus * skinMult * ach_cpc * ach_all
	data.clicksPerSecond = cps              * spBonus * mult * sp_cps_bonus * sp_all_bonus * skinMult * ach_cps * ach_all
end

