RE_deletePet.OnServerEvent:Connect(function(player, petId, amount)
	local data = playerData[player.UserId]
	if not data then return end
	if type(petId) ~= "string" then return end

	data.petCounts = data.petCounts or {}
	local count = data.petCounts[petId] or 0
	if count <= 0 then return end

	local amt = math.clamp(math.floor(asNumber(amount) or 1), 1, count)
	data.petCounts[petId] = count - amt

	if data.petCounts[petId] <= 0 then
		data.petCounts[petId] = nil
		for i = #data.inventory, 1, -1 do
			if data.inventory[i] == petId then table.remove(data.inventory, i) break end
		end
		if data.equippedSkin == petId then data.equippedSkin = "dog" end
	end
	recalculateStats(data)
	syncPlayer(player)
end)

local clickCounts = {}
local MAX_ACCEPTED_CLICKS_PER_SEC = 25
local CLICK_RATE_BURST_ALLOWANCE = 15
local clickRateState = {}

local function consumeClickBudget(userId, requestedClicks)
	requestedClicks = math.max(0, math.floor(asNumber(requestedClicks) or 0))
	if requestedClicks <= 0 then return 0 end

	local now = tick()
	local maxTokens = MAX_ACCEPTED_CLICKS_PER_SEC + CLICK_RATE_BURST_ALLOWANCE
	local state = clickRateState[userId]
	if not state then
		state = { tokens = maxTokens, last = now }
		clickRateState[userId] = state
	end

	local elapsed = math.max(0, now - (state.last or now))
	state.last = now
	state.tokens = math.min(maxTokens, (state.tokens or maxTokens) + elapsed * MAX_ACCEPTED_CLICKS_PER_SEC)

	local allowed = math.min(requestedClicks, math.floor(state.tokens))
	if allowed <= 0 then return 0 end
	state.tokens -= allowed
	return allowed
end

RE_onClick.OnServerEvent:Connect(function(player, count)
	local data = playerData[player.UserId]
	if not data then return end

	local uid = player.UserId
	local requested = math.min(math.max(math.floor(asNumber(count) or 1), 1), 45)
	local n = consumeClickBudget(uid, requested)
	if n <= 0 then return end
	local baseEarn = math.max(0, asNumber(data.clicksPerClick) or 0)
	if baseEarn <= 0 then return end

	for _ = 1, n do
		local earned = baseEarn
		local critChance = data.critChance or 0
		if critChance > 0 and math.random() < critChance then
			earned = earned * 5
		end
		data.clicks         += earned
		data.totalClicks    += earned
	end
	data.lifetimeClicks = (data.lifetimeClicks or 0) + n

	checkAchievements(data, player)
	local hasNewAch = data.newAchievements and #data.newAchievements > 0

	clickCounts[uid] = (clickCounts[uid] or 0) + n
	if clickCounts[uid] >= 5 or hasNewAch then
		clickCounts[uid] = 0
		syncPlayer(player)
	end
end)

