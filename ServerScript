local function asNumber(v)
	if type(v) == "number" then return v end
	if type(v) == "string" then return tonumber(v) end
	return nil
end

local function unixMillis()
	return DateTime.now().UnixTimestampMillis
end

local function getSPUpgradeDef(id)
	for _, u in ipairs(SP_UPGRADES) do
		if u.id == id then return u end
	end
end

local function getSPUpgradeCost(id, level)
	local def = getSPUpgradeDef(id)
	if not def then return math.huge end
	return def.cost[level + 1] or math.huge
end

