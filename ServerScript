local function saveData(player)
	local data = playerData[player.UserId]
	if not data then return end

	local function round3(n)
		n = asNumber(n) or 0
		return math.round(n * 1000) / 1000
	end

	data.sessionKey = math.max(0, math.floor(asNumber(data.sessionKey) or unixMillis()))
	data.saveSeq = math.max(0, math.floor(asNumber(data.saveSeq) or 0)) + 1

	local saveTable = {
		clicks       = round3(data.clicks),
		totalClicks  = round3(data.totalClicks),
		prestige     = data.prestige,
		upgrades     = data.upgrades,
		inventory    = data.inventory,
		equippedSkin = data.equippedSkin,
		starPoints     = data.starPoints or 0,
		spUpgrades     = data.spUpgrades or {},
		pityLeg        = data.pityLeg or {0,0,0},
		pityMythic     = data.pityMythic or {0,0,0},
		achievements        = data.achievements or {},
		claimedAchievements = data.claimedAchievements or {},
		dailyStreak       = data.dailyStreak or 0,
		lastLoginDate     = data.lastLoginDate or "",
		dailyRewardDay    = data.dailyRewardDay or 1,
		dailyNextClaimTime = data.dailyNextClaimTime or 0,
		dailySessionSeconds = data.dailySessionSeconds or 0,
		totalSPEarned  = data.totalSPEarned or 0,
		lifetimeClicks = math.floor(data.lifetimeClicks or 0),
		petCounts      = data.petCounts or {},   -- NEW: save golden pet copy counts
		__sessionKey = data.sessionKey,
		__saveSeq = data.saveSeq,
		__savedAt = os.time(),
	}

	local success, err = pcall(function()
		GameStore:UpdateAsync("player_" .. player.UserId, function(old)
			if type(old) == "table" then
				local oldSession = math.max(0, math.floor(asNumber(old.__sessionKey) or 0))
				local oldSeq = math.max(0, math.floor(asNumber(old.__saveSeq) or 0))
				if oldSession > data.sessionKey then return old end
				if oldSession == data.sessionKey and oldSeq > data.saveSeq then return old end
			end
			return saveTable
		end)
	end)

	if not success then
		warn("Failed to save data for " .. player.Name .. ": " .. tostring(err))
	else
		print("Saved data for " .. player.Name)
	end
end

local function loadData(player)
	local saved = nil

	local success, result = pcall(function()
		saved = GameStore:GetAsync("player_" .. player.UserId)
	end)

	local data = createPlayerData(player)

	if success and saved then
		data.clicks       = math.max(0, asNumber(saved.clicks) or 0)
		data.totalClicks  = math.max(0, asNumber(saved.totalClicks) or 0)
		data.prestige     = math.max(0, math.floor(asNumber(saved.prestige) or 0))

		-- Validate equippedSkin — allow both regular and golden pets
		local savedSkin = saved.equippedSkin or "dog"
		if savedSkin ~= "dog" then
			local valid = getPetDef(savedSkin) ~= nil
			if not valid and isGoldenPet(savedSkin) then
				local baseId = getGoldenBasePetId(savedSkin)
				valid = baseId ~= nil and getPetDef(baseId) ~= nil
			end
			if not valid then savedSkin = "dog" end
		end
		data.equippedSkin = savedSkin

		if type(saved.upgrades) == "table" then
			for _, def in ipairs(UPGRADES) do
				local lv = asNumber(saved.upgrades[def.id])
				if lv then
					data.upgrades[def.id] = math.clamp(math.floor(lv), 0, def.maxLevel)
				end
			end
		end

		data.starPoints     = math.max(0, math.floor(asNumber(saved.starPoints) or 0))
		data.totalSPEarned  = math.max(0, math.floor(asNumber(saved.totalSPEarned) or 0))
		data.lifetimeClicks = math.max(0, math.floor(asNumber(saved.lifetimeClicks) or 0))
		data.dailyStreak       = math.max(0, math.floor(asNumber(saved.dailyStreak) or 0))
		data.lastLoginDate     = (type(saved.lastLoginDate) == "string" and saved.lastLoginDate) or ""
		data.dailyRewardDay     = math.max(1, math.min(7, math.floor(asNumber(saved.dailyRewardDay) or 1)))
		data.dailyNextClaimTime = math.max(0, asNumber(saved.dailyNextClaimTime) or 0)
		data.dailySessionSeconds = math.max(0, math.min(DAILY_SESSION_REQ, math.floor(asNumber(saved.dailySessionSeconds) or 0)))
		if type(saved.pityLeg) == "table" then
			data.pityLeg = {}
			for i = 1, 3 do data.pityLeg[i] = math.max(0, math.floor(asNumber(saved.pityLeg[i]) or 0)) end
		end
		if type(saved.pityMythic) == "table" then
			data.pityMythic = {}
			for i = 1, 3 do data.pityMythic[i] = math.max(0, math.floor(asNumber(saved.pityMythic[i]) or 0)) end
		end

		if type(saved.spUpgrades) == "table" then
			for _, def in ipairs(SP_UPGRADES) do
				local lv = asNumber(saved.spUpgrades[def.id])
				if lv then
					data.spUpgrades[def.id] = math.clamp(math.floor(lv), 0, def.maxLevel)
				end
			end
		end
		if type(saved.achievements) == "table" then
			for _, def in ipairs(ACHIEVEMENTS) do
				if saved.achievements[def.id] == true then
					data.achievements[def.id] = true
				end
			end
		end
		if type(saved.claimedAchievements) == "table" then
			for _, def in ipairs(ACHIEVEMENTS) do
				if saved.claimedAchievements[def.id] == true and data.achievements[def.id] == true then
					data.claimedAchievements[def.id] = true
				end
			end
		end

		-- Inventory cleaning: allow regular pets AND golden pets
		if type(saved.inventory) == "table" then
			local cleanedInventory = { "dog" }
			local seen = { dog = true }
			for _, id in ipairs(saved.inventory) do
				if type(id) == "string" and not seen[id] then
					local valid = false
					if id == "dog" then
						valid = true
					elseif isGoldenPet(id) then
						-- Validate: base pet must exist
						local baseId = getGoldenBasePetId(id)
						valid = baseId ~= nil and (getPetDef(baseId) ~= nil or baseId == "dog")
					else
						valid = getPetDef(id) ~= nil
					end
					if valid then
						table.insert(cleanedInventory, id)
						seen[id] = true
					end
				end
			end
			data.inventory = cleanedInventory
		end

		-- Load petCounts with migration support for old saves
		if type(saved.petCounts) == "table" then
			data.petCounts = {}
			for petId, count in pairs(saved.petCounts) do
				if type(petId) == "string" and type(count) == "number" then
					local n = math.max(0, math.floor(count))
					if n > 0 then data.petCounts[petId] = n end
				end
			end
		else
			-- Migration: old save has no petCounts — init count=1 per unique pet
			data.petCounts = {}
			for _, petId in ipairs(data.inventory) do
				data.petCounts[petId] = (data.petCounts[petId] or 0) + 1
			end
		end
		-- Always ensure dog has at least 1
		if not data.petCounts["dog"] or data.petCounts["dog"] < 1 then
			data.petCounts["dog"] = 1
		end

		-- Equipped skin fallback if inventory is inconsistent
		if data.equippedSkin ~= "dog" and not hasInInventory(data, data.equippedSkin) then
			data.equippedSkin = "dog"
		end

		print("Loaded data for " .. player.Name)
	else
		if not success then
			warn("Failed to load data for " .. player.Name .. ": " .. tostring(result))
		else
			print("No saved data for " .. player.Name .. " - starting fresh")
		end
	end

	playerData[player.UserId] = data
	return data
end

-- ============================================================
-- PLAYER JOIN / LEAVE
-- ============================================================

local sessionThreads = {}

Players.PlayerAdded:Connect(function(player)
	local data = loadData(player)
	normalizeDailyProgress(data, os.time())
	recalculateStats(data)
	checkAchievements(data, player)
	task.wait(0.5)
	syncPlayer(player)
	if isAdmin(player) then
		task.delay(0.3, function()
			RE_adminCheck:FireClient(player)
		end)
	end

	local uid = player.UserId
	sessionThreads[uid] = task.spawn(function()
		while playerData[uid] do
			task.wait(1)
			local d = playerData[uid]
			if not d then break end
			local now = os.time()
			if now >= (d.dailyNextClaimTime or 0) then
				d.dailySessionSeconds = math.min((d.dailySessionSeconds or 0) + 1, DAILY_SESSION_REQ)
			end
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	local uid = player.UserId
	if sessionThreads[uid] then
		task.cancel(sessionThreads[uid])
		sessionThreads[uid] = nil
	end
	saveData(player)
	playerData[uid] = nil
	clickCounts[uid] = nil
	clickRateState[uid] = nil
end)

task.spawn(function()
	while true do
		task.wait(60)
		local players = Players:GetPlayers()
		for i, player in ipairs(players) do
			saveData(player)
			if i < #players then task.wait(1) end
		end
	end
end)

game:BindToClose(function()
	local playerList = Players:GetPlayers()
	if #playerList == 0 then return end

	local pending = #playerList

	for _, player in ipairs(playerList) do
		task.spawn(function()
			saveData(player)
			pending -= 1
		end)
	end

	local deadline = tick() + 25
	while pending > 0 and tick() < deadline do
		task.wait(0.5)
	end

	if pending > 0 then
		warn(string.format("BindToClose: %d save(s) did not complete before shutdown!", pending))
	end
end)

-- ============================================================
-- ADMIN COMMAND HANDLER
-- ============================================================

local function fmtAdmin(n)
	n = math.floor(asNumber(n) or 0)
	if     n >= 1e12 then return string.format("%.2fT", n/1e12)
	elseif n >= 1e9  then return string.format("%.2fB", n/1e9)
	elseif n >= 1e6  then return string.format("%.2fM", n/1e6)
	elseif n >= 1e3  then return string.format("%.1fK", n/1e3)
	else return tostring(n) end
end

RE_adminCmd.OnServerEvent:Connect(function(player, cmd, targetName, arg1)
	if not isAdmin(player) then
		warn("[ADMIN] Non-admin '"..player.Name.."' sent admin cmd: "..tostring(cmd))
		return
	end

	local target = nil
	local tname  = tostring(targetName or ""):lower()
	if tname == "_self" or tname == player.Name:lower() then
		target = player
	else
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower() == tname then target = p; break end
		end
	end

	if not target then
		RE_adminResp:FireClient(player, false, "Player not found: "..tostring(targetName))
		return
	end

	local data = playerData[target.UserId]
	if not data then
		RE_adminResp:FireClient(player, false, "No data for: "..target.Name)
		return
	end

	local amount = math.floor(asNumber(arg1) or 0)

	if cmd == "give_clicks" then
		local n = math.max(0, math.min(amount, 1e15))
		data.clicks      += n
		data.totalClicks += n
		recalculateStats(data)
		checkAchievements(data, target)
		syncPlayer(target)
		RE_adminResp:FireClient(player, true, "Gave "..fmtAdmin(n).." clicks → "..target.Name)

	elseif cmd == "give_sp" then
		local n = math.max(0, math.min(amount, 999999))
		data.starPoints    = (data.starPoints    or 0) + n
		data.totalSPEarned = (data.totalSPEarned or 0) + n
		recalculateStats(data)
		checkAchievements(data, target)
		syncPlayer(target)
		RE_adminResp:FireClient(player, true, "Gave "..n.." SP → "..target.Name)

	elseif cmd == "set_prestige" then
		local n = math.max(0, math.min(amount, MAX_PRESTIGE))
		data.prestige = n
		recalculateStats(data)
		syncPlayer(target)
		RE_adminResp:FireClient(player, true, "Prestige → "..n.." for "..target.Name)

	elseif cmd == "reset_all" then
		local uid = target.UserId
		playerData[uid] = createPlayerData(target)
		recalculateStats(playerData[uid])
		syncPlayer(target)
		RE_adminResp:FireClient(player, true, "FULL RESET → "..target.Name)

	else
		RE_adminResp:FireClient(player, false, "Unknown command: "..tostring(cmd))
	end
end)

-- ============================================================
-- AUTO-CPS TICK  (every 1 second)
-- ============================================================

while true do
	task.wait(1)
	for userId, data in pairs(playerData) do
		if data.clicksPerSecond > 0 then
			local earned = math.max(0, data.clicksPerSecond)
			data.clicks      += earned
			data.totalClicks += earned
			local pl = Players:GetPlayerByUserId(userId)
			if pl then
				checkAchievements(data, pl)
				local now = os.time()
				local is24h = now < (data.dailyNextClaimTime or 0)
				RE_syncData:FireClient(pl, {
					clicks           = data.clicks,
					totalClicks      = data.totalClicks,
					clicksPerClick   = data.clicksPerClick,
					clicksPerSecond  = data.clicksPerSecond,
					starPoints       = data.starPoints,
					prestige         = data.prestige,
					dailyIs24hPhase  = is24h,
					dailySecondsRemaining = is24h
						and math.max(0, math.floor((data.dailyNextClaimTime or 0) - now))
						or  math.max(0, DAILY_SESSION_REQ - (data.dailySessionSeconds or 0)),
					newAchievements  = data.newAchievements or {},
				})
				data.newAchievements = {}
			end
		end
	end
end
