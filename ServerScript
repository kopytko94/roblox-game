local EGG_COSTS = { [1] = 50000, [2] = 10000000, [3] = 20000000000 }
local MAX_EGG_DISCOUNT = 0.45

local function getEffectiveEggCost(data, eggNum)
	local baseCost = EGG_COSTS[eggNum]
	if not baseCost then return nil end
	local discount = math.clamp(data.eggDiscount or 0, 0, MAX_EGG_DISCOUNT)
	return math.max(1, math.floor(baseCost * (1 - discount)))
end

