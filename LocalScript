	tw(clickBtn, FAST, {Size=UDim2.new(0,BTN_SIZE-39,0,BTN_SIZE-39), Position=UDim2.new(BTN_CX,-(BTN_SIZE-39)/2,BTN_CY,BTN_OY-(BTN_SIZE-39)/2)}):Play()
