local function fmt(n)
	n = math.floor(n)
	if     n >= 1e12 then return ("%.2fT"):format(n/1e12)
	elseif n >= 1e9  then return ("%.2fB"):format(n/1e9)
	elseif n >= 1e6  then return ("%.2fM"):format(n/1e6)
	elseif n >= 1e3  then return ("%.1fK"):format(n/1e3)
	else return tostring(n) end
end

local function asNumber(v)
	if type(v) == "number" then return v end
	if type(v) == "string" then return tonumber(v) end
	return nil
end

local function fmtPrecise(n)
	n = asNumber(n) or 0
	local abs = math.abs(n)
	if abs >= 1e12 then return ("%.2fT"):format(n / 1e12)
	elseif abs >= 1e9 then return ("%.2fB"):format(n / 1e9)
	elseif abs >= 1e6 then return ("%.2fM"):format(n / 1e6)
	elseif abs >= 1e3 then
		local s = ("%.2fK"):format(n / 1e3)
		return s:gsub("0+$", ""):gsub("%.$", "")
	else
		local rounded = math.round(n * 100) / 100
		if math.abs(rounded - math.floor(rounded)) < 1e-6 then return tostring(math.floor(rounded)) end
		local s = ("%.2f"):format(rounded)
		return s:gsub("0+$", ""):gsub("%.$", "")
	end
end

