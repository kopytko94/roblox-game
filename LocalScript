	local function normalizeIconId(raw)
		if type(raw) ~= "string" then return nil end
		local trimmed = string.gsub(raw, "^%s*(.-)%s*$", "%1")
		if trimmed == "" then return nil end
		if string.match(trimmed, "^rbxassetid://%d+$") then return trimmed end
		if string.match(trimmed, "^%d+$") then return "rbxassetid://" .. trimmed end
		local idFromHttp = string.match(trimmed, "^https?://www%.roblox%.com/asset/%?id=(%d+)$")
		if idFromHttp then return "rbxassetid://" .. idFromHttp end
		return nil
	end

	local function tryLoadIconsFromFolder()
		local folder = ReplicatedStorage:FindFirstChild("UiIcons")
		if not folder then return end

		for _, obj in ipairs(folder:GetChildren()) do
			local raw = nil
			if obj:IsA("Decal") then raw = obj.Texture
			elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then raw = obj.Image
			elseif obj:IsA("StringValue") then raw = obj.Value
			elseif obj:IsA("Texture") then raw = obj.Texture end

			local normalized = normalizeIconId(raw)
			if normalized then ICONS[obj.Name] = normalized end
		end
	end

	local function resolveIcon(iconKey, fallbackText)
		local raw = iconKey and ICONS[iconKey] or nil
		local normalized = normalizeIconId(raw)
		if normalized then return normalized, nil end
		return nil, fallbackText or ""
	end

	makeIconLabel = function(parent, props)
		local icon = Instance.new("ImageLabel")
		icon.BackgroundTransparency = 1
		icon.BorderSizePixel = 0
		icon.ScaleType = Enum.ScaleType.Fit
		for k, v in pairs(props) do icon[k] = v end
		icon.Parent = parent
		return icon
	end

	setIcon = function(targetImageLabel, iconKey, fallbackTextLabel, fallbackText, tintColor)
		if not targetImageLabel then return end
		local imageId, fallback = resolveIcon(iconKey, fallbackText)
		if imageId then
			targetImageLabel.Image = imageId
			targetImageLabel.ImageColor3 = tintColor or Color3.fromRGB(255, 255, 255)
			targetImageLabel.Visible = true
			if fallbackTextLabel then fallbackTextLabel.Visible = false end
		else
			targetImageLabel.Image = ""
			targetImageLabel.Visible = false
			if fallbackTextLabel then
				fallbackTextLabel.Text = fallback
				fallbackTextLabel.Visible = true
			end
		end
	end

	local function preloadIcons()
		local ids = {}
		local seen = {}
		for _, raw in pairs(ICONS) do
			local normalized = normalizeIconId(raw)
			if normalized and not seen[normalized] then
				seen[normalized] = true
				table.insert(ids, normalized)
			end
		end
		if #ids == 0 then return end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(ids) end)
	end

	tryLoadIconsFromFolder()
	task.spawn(function()
		preloadIcons()
		if _G._onIconsLoaded then _G._onIconsLoaded() end
	end)
end

