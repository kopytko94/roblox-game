function refreshInventory()
	for petId, ui in pairs(invCards) do
		local inInv = false
		for _, id in ipairs(localData.inventory) do if id == petId then inInv = true break end end
		if not inInv then ui.card:Destroy(); invCards[petId] = nil; invCardsBuilt[petId] = nil end
	end

	for _, petId in ipairs(localData.inventory) do if not invCardsBuilt[petId] then buildInvCard(petId) end end

	for _, petId in ipairs(localData.inventory) do
		local ui = invCards[petId]
		local pd = getPetInfo(petId)
		if ui and pd then
			local rVal = RARITY_VAL[pd.rarity] or 1
			if pd.isGolden then rVal = rVal + 0.5 end
			local mVal = pd.multiplier
			local sortWeight = 0
			if currentSortIdx == 1 then
				sortWeight = -mVal * 1000 - rVal
			elseif currentSortIdx == 2 then
				sortWeight = -rVal * 1000 - mVal
			elseif currentSortIdx == 3 then
				sortWeight = mVal * 1000 + rVal
			elseif currentSortIdx == 4 then
				sortWeight = rVal * 1000 + mVal
			end
			ui.card.LayoutOrder = math.floor(sortWeight * 100)
		end
	end

	for petId, ui in pairs(invCards) do
		local count = localData.petCounts and localData.petCounts[petId] or 1
		ui.countLbl.Text = "x" .. count
		ui.craftBtn.Visible = (not ui.pd.isGolden and count >= 5)

		local isEq = localData.equippedSkin == petId
		if isEq then
			ui.eqBtn.Text = "UNEQUIP"; ui.eqBtn.BackgroundColor3 = ui.eqBtnHovered and PET_THEME.btnUnequipHover or PET_THEME.btnUnequip
			ui.eqBtn.TextColor3 = Color3.fromRGB(255, 245, 245)
			if ui.eqBtnStroke then ui.eqBtnStroke.Color = Color3.fromRGB(255, 112, 132); ui.eqBtnStroke.Transparency = 0 end
		else
			ui.eqBtn.Text = "EQUIP"; ui.eqBtn.BackgroundColor3 = ui.eqBtnHovered and PET_THEME.btnEquipHover or PET_THEME.btnEquip
			ui.eqBtn.TextColor3 = Color3.fromRGB(30, 18, 0)
			if ui.eqBtnStroke then ui.eqBtnStroke.Color = ui.rarityColor or PET_THEME.panelStroke; ui.eqBtnStroke.Transparency = 0.1 end
		end
		if isEq then tw(ui.cardStroke, MED, {Color=Color3.fromRGB(255, 230, 110), Transparency=0}):Play() else tw(ui.cardStroke, MED, {Color=ui.rarityColor or PET_THEME.panelStroke, Transparency=0.15}):Play() end
	end

	local pd = getPetInfo(localData.equippedSkin or "dog")
	if pd then
		local rc = pd.isGolden and C.gold or (PET_RARITY_NEON[pd.rarity] or RARITY_COLOR[pd.rarity])
		setIcon(equippedIconImage, "pet_" .. pd.baseId, equippedEmoji, pd.emoji, rc)
		equippedName.Text = pd.name; equippedRarity.Text = pd.rarity; equippedRarity.TextColor3 = rc; equippedMult.Text = "x"..pd.multiplier; equippedMult.TextColor3 = rc; equippedBannerStroke.Color = rc
	end

	invScroll.CanvasSize = UDim2.new(0,0,0,invGrid.AbsoluteContentSize.Y+16)
end

