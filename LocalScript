		end

		canTapToClaim = true; rollRunning = false
	end

	RE_rollEgg.OnClientEvent:Connect(function(result)
		if type(result) ~= "table" then rollRunning = false; closeRollOverlay(); return end
		local incomingEggNum = tonumber(result.eggNum)
		if awaitingRollResult and pendingEggNum and incomingEggNum and math.floor(incomingEggNum) ~= pendingEggNum then return end
