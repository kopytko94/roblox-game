-- SAFE REMOTE LOADER
-- ============================================================

local RE_onClick, RE_buyUpgrade, RE_doPrestige, RE_syncData
local RE_rollEgg, RE_buySPUpgrade, RE_equipSkin, RE_claimDaily, RE_claimAchieve, RE_craftGolden
local RE_deletePet, RE_adminCheck, RE_adminCmd, RE_adminResp

do
	local function safeWait(parent, name, timeout)
		local ok, result = pcall(function()
			return parent:WaitForChild(name, timeout)
		end)
		return (ok and result) or nil
	end

	local remotesFolder = safeWait(ReplicatedStorage, "ClickerRemotes", 20)
	if not remotesFolder then
		local errGui = Instance.new("ScreenGui")
		errGui.Name = "ClickerError"; errGui.ResetOnSpawn = false; errGui.Parent = playerGui
		local errFrame = Instance.new("Frame", errGui)
		errFrame.Size = UDim2.new(1,0,1,0); errFrame.BackgroundColor3 = Color3.fromRGB(6,6,18)
		local errLbl = Instance.new("TextLabel", errFrame)
		errLbl.Size = UDim2.new(0.9,0,0.3,0); errLbl.Position = UDim2.new(0.05,0,0.35,0)
		errLbl.BackgroundTransparency = 1; errLbl.TextColor3 = Color3.fromRGB(255,80,80)
		errLbl.TextSize = 22; errLbl.Font = Enum.Font.GothamBold; errLbl.TextWrapped = true
		errLbl.Text = ("⚠ ERROR: ClickerRemotes not found in ReplicatedStorage!");
		warn("ClickerGame LocalScript: ClickerRemotes not found after 20s – check ServerScript in Output!")
		return
	end

	local REMOTE_NAMES = {"OnClick","BuyUpgrade","DoPrestige","SyncData","RollEgg","BuySPUpgrade","EquipSkin","ClaimDaily","ClaimAchievement","CraftGolden","DeletePet"}
	local _remotes = {}
	local _missingAny = false
	for _, name in ipairs(REMOTE_NAMES) do
		local re = safeWait(remotesFolder, name, 10)
		if not re then
			warn("ClickerGame: Missing remote: " .. name)
			_missingAny = true
		end
		_remotes[name] = re
	end
	if _missingAny then
		warn("ClickerGame: One or more remotes missing – check Output for which ones. ServerScript may have errored.")
		return
	end

	RE_onClick      = _remotes["OnClick"]
	RE_buyUpgrade   = _remotes["BuyUpgrade"]
	RE_doPrestige   = _remotes["DoPrestige"]
	RE_syncData     = _remotes["SyncData"]
	RE_rollEgg      = _remotes["RollEgg"]
	RE_buySPUpgrade = _remotes["BuySPUpgrade"]
	RE_equipSkin    = _remotes["EquipSkin"]
	RE_claimDaily    = _remotes["ClaimDaily"]
	RE_claimAchieve  = _remotes["ClaimAchievement"]
	RE_craftGolden   = _remotes["CraftGolden"]
	RE_deletePet     = _remotes["DeletePet"]

end
print("ClickerGame LocalScript: All remotes loaded OK")

do
