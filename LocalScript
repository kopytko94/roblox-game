local CLICK_COOLDOWN = 0.022
local lastClickSent, pendingClicks, achRefreshAccum = 0, 0, 0
local CLIENT_MAX_CPS = 20
local clientClickLog = {}
local VISUAL_COOLDOWN = 0.07
local lastVisualTime, pendingVisualVal = 0, 0

local function doClickVisual(isAuto)
	local now = tick()
	local i = 1
	while i <= #clientClickLog do if now - clientClickLog[i] > 1 then table.remove(clientClickLog, i) else i += 1 end end
	if #clientClickLog >= CLIENT_MAX_CPS then return end
	table.insert(clientClickLog, now)

	local earned = math.max(0, asNumber(localData.clicksPerClick) or 0)
	if earned <= 0 then return end
	local critChance = localData.critChance or 0
	local isCrit = critChance > 0 and math.random() < critChance
	if isCrit then earned = earned * 5 end

	localData.lifetimeClicks = (localData.lifetimeClicks or 0) + 1
	recordManualClick(earned); displayedClicks += earned
	if not headerShowingSP then headerClickLabel.Text = fmt(displayedClicks) end

	if isAuto then
		pendingVisualVal += earned
		if now - lastVisualTime >= VISUAL_COOLDOWN then
			lastVisualTime = now; floatText(pendingVisualVal, false); pendingVisualVal = 0
		end
	else
		floatText(earned, isCrit)
		if isCrit then
			local cf = lbl(S_MAIN, {Size=UDim2.new(0,140,0,36), Position=UDim2.new(BTN_CX, lastMouseX - 70, BTN_CY, BTN_OY + lastMouseY - 48), Text="CRIT! ×5", TextColor3=Color3.fromRGB(255,80,80), TextSize=26, Font=Enum.Font.Bangers, ZIndex=11})
			local critStroke = Instance.new("UIStroke"); critStroke.Color = Color3.fromRGB(0,0,0); critStroke.Thickness = 2; critStroke.Parent = cf
			local critTI = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			tw(cf, critTI, {Position=UDim2.new(BTN_CX, lastMouseX - 70, BTN_CY, BTN_OY - BTN_SIZE/2 - 100), TextTransparency=1}):Play()
			tw(critStroke, critTI, {Transparency=1}):Play(); task.delay(0.95, function() cf:Destroy() end)
		end
	end
end

clickBtn.MouseButton1Up:Connect(function()
	if _G._autoClickerActive then
		local warning = _G._autoClickWarning
		if warning then warning.Visible = true; task.delay(1.5, function() warning.Visible = false end) end
		return
	end
	tw(clickBtn, BACK, {Size=UDim2.new(0,BTN_SIZE,0,BTN_SIZE), Position=UDim2.new(BTN_CX,-BTN_SIZE/2,BTN_CY,BTN_OY-BTN_SIZE/2)}):Play()
