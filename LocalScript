local function buildInvCard(petId)
	if invCardsBuilt[petId] then return end
	invCardsBuilt[petId] = true

	local pd = getPetInfo(petId); if not pd then return end
	local neon = pd.isGolden and C.gold or (PET_RARITY_NEON[pd.rarity] or RARITY_COLOR[pd.rarity] or C.grey)
	local deep = pd.isGolden and Color3.fromRGB(40, 25, 0) or (PET_RARITY_BG[pd.rarity] or PET_THEME.panelSoft)

	local card = frm(invScroll, {Size=UDim2.new(0,170,0,244), BackgroundColor3=PET_THEME.panelBg, ZIndex=4})
	corner(card, UDim.new(0,16)); local cardStroke = uistroke(card, neon, 2, 0.15)
	local cardGrad = Instance.new("UIGradient")
	cardGrad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, PET_THEME.panelBg), ColorSequenceKeypoint.new(1, deep)})
	cardGrad.Rotation = 90; cardGrad.Parent = card

	local countBadge = frm(card, {Size=UDim2.new(0,34,0,22), Position=UDim2.new(1,-40,0,6), BackgroundColor3=Color3.fromRGB(10,8,18), ZIndex=5})
	corner(countBadge, UDim.new(0,6)); uistroke(countBadge, neon, 1, 0.2)
	local countLbl = lbl(countBadge, {Size=UDim2.new(1,0,1,0), Text="x1", TextColor3=neon, TextSize=13, Font=Enum.Font.GothamBold, ZIndex=6})

	local petIconFallback = lbl(card, {Size=UDim2.new(1,0,0,74), Position=UDim2.new(0,0,0,5), Text=pd.emoji, TextSize=54, Font=Enum.Font.GothamBold, ZIndex=5})
	local petIconImg = makeIconLabel(card, {Size=UDim2.new(0.68,0,0,62), Position=UDim2.new(0.16,0,0,10), ZIndex=6, Visible=false})
	setIcon(petIconImg, "pet_" .. tostring(pd.baseId), petIconFallback, pd.emoji, neon)

	lbl(card, {Size=UDim2.new(1,-8,0,24), Position=UDim2.new(0,4,0,82), Text=pd.name, TextColor3=pd.isGolden and C.gold or Color3.fromRGB(246, 240, 255), TextSize=16, Font=Enum.Font.Bangers, ZIndex=5})

	local baseRarityColor = RARITY_COLOR[pd.rarity] or C.grey
	if pd.isGolden then
		local rbadge = frm(card, {Size=UDim2.new(0.38,0,0,20), Position=UDim2.new(0.09,0,0,108), BackgroundColor3=Color3.fromRGB(16, 13, 28), ZIndex=5})
		corner(rbadge, UDim.new(0,5)); uistroke(rbadge, baseRarityColor, 1, 0.1)
		lbl(rbadge, {Size=UDim2.new(1,0,1,0), Text=pd.rarity, TextColor3=baseRarityColor, TextSize=10, Font=Enum.Font.GothamBold, ZIndex=6})

		local gbadge = frm(card, {Size=UDim2.new(0.38,0,0,20), Position=UDim2.new(0.53,0,0,108), BackgroundColor3=Color3.fromRGB(30, 24, 0), ZIndex=5})
		corner(gbadge, UDim.new(0,5)); uistroke(gbadge, C.gold, 1, 0.1)
		lbl(gbadge, {Size=UDim2.new(1,0,1,0), Text="Golden", TextColor3=C.gold, TextSize=10, Font=Enum.Font.GothamBold, ZIndex=6})
	else
		local rbadge = frm(card, {Size=UDim2.new(0.82,0,0,20), Position=UDim2.new(0.09,0,0,108), BackgroundColor3=Color3.fromRGB(16, 13, 28), ZIndex=5})
		corner(rbadge, UDim.new(0,5)); uistroke(rbadge, neon, 1, 0.1)
		lbl(rbadge, {Size=UDim2.new(1,0,1,0), Text=pd.rarity, TextColor3=neon, TextSize=10, Font=Enum.Font.GothamBold, ZIndex=6})
	end

	lbl(card, {Size=UDim2.new(1,0,0,24), Position=UDim2.new(0,0,0,136), Text="x"..fmtPrecise(pd.multiplier).." mult", TextColor3=neon, TextSize=18, Font=Enum.Font.Bangers, ZIndex=5})

	local delBtn = tbtn(card, {Size=UDim2.new(0,24,0,24), Position=UDim2.new(0,6,0,6), BackgroundColor3=Color3.fromRGB(40,15,15), Text="🗑", TextColor3=C.red, TextSize=12, ZIndex=6})
	corner(delBtn, UDim.new(0,6)); uistroke(delBtn, C.red, 1, 0.3)
	delBtn.MouseButton1Click:Connect(function()
		if localData.equippedSkin == petId and (localData.petCounts[petId] or 1) <= 1 then return end
		if localData.equippedSkin == petId and ((localData.petCounts and localData.petCounts[petId]) or 1) <= 1 then return end
		currentDelPetId = petId
		if delInput then delInput.Text = "1" end
		if pd and delSubLabel then delSubLabel.Text = "How many " .. pd.name .. " would you like to delete?" end
		if delPopup then delPopup.Visible = true; delPopup.BackgroundTransparency = 0; delDimmer.Visible = true end
	end)

	local craftBtn = tbtn(card, {Size=UDim2.new(0.86,0,0,30), Position=UDim2.new(0.07,0,0,166), BackgroundColor3=C.gold, Text="CRAFT GOLDEN", TextColor3=Color3.fromRGB(30,20,0), TextSize=14, Font=Enum.Font.Bangers, ZIndex=5, Visible=false})
	corner(craftBtn, UDim.new(0,6))
	craftBtn.MouseEnter:Connect(function() tw(craftBtn, FAST, {BackgroundColor3=Color3.fromRGB(255,230,80)}):Play() end)
	craftBtn.MouseLeave:Connect(function() tw(craftBtn, FAST, {BackgroundColor3=C.gold}):Play() end)
	craftBtn.MouseButton1Click:Connect(function() RE_craftGolden:FireServer(petId) end)

	local eqBtn = tbtn(card, {Size=UDim2.new(0.86,0,0,34), Position=UDim2.new(0.07,0,0,202), BackgroundColor3=PET_THEME.btnIdle, Text="EQUIP", TextColor3=PET_THEME.btnIdleText, TextSize=15, Font=Enum.Font.GothamBold, ZIndex=5})
	corner(eqBtn, UDim.new(0,8)); local eqBtnStroke = uistroke(eqBtn, neon, 1, 0.2)

	local function applyEqButtonStyle(isEq, hovered)
		if isEq then
			eqBtn.Text = "UNEQUIP"; eqBtn.BackgroundColor3 = hovered and PET_THEME.btnUnequipHover or PET_THEME.btnUnequip
			eqBtn.TextColor3 = Color3.fromRGB(255, 245, 245); eqBtnStroke.Color = Color3.fromRGB(255, 112, 132); eqBtnStroke.Transparency = 0
		else
			eqBtn.Text = "EQUIP"; eqBtn.BackgroundColor3 = hovered and PET_THEME.btnEquipHover or PET_THEME.btnEquip
			eqBtn.TextColor3 = Color3.fromRGB(30, 18, 0); eqBtnStroke.Color = neon; eqBtnStroke.Transparency = 0.1
		end
	end

	applyEqButtonStyle(localData.equippedSkin == petId, false)
	invCards[petId] = {card=card, eqBtn=eqBtn, eqBtnStroke=eqBtnStroke, cardStroke=cardStroke, rarityColor=neon, eqBtnHovered=false, countLbl=countLbl, craftBtn=craftBtn, pd=pd}

	eqBtn.MouseEnter:Connect(function() invCards[petId].eqBtnHovered = true; applyEqButtonStyle(localData.equippedSkin == petId, true) end)
	eqBtn.MouseLeave:Connect(function() invCards[petId].eqBtnHovered = false; applyEqButtonStyle(localData.equippedSkin == petId, false) end)
	eqBtn.MouseButton1Click:Connect(function() local targetSkin = (localData.equippedSkin == petId) and "dog" or petId; localData.equippedSkin = targetSkin; refreshInventory(); RE_equipSkin:FireServer(targetSkin) end)
end

