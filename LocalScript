		if result.ok ~= true then rollRunning = false; closeRollOverlay(); showRollFailureToast(getRollFailureText(result)); return end
		task.spawn(function() local ok, err = pcall(playRoll, result); if not ok then rollRunning = false; closeRollOverlay() end end)
	end)

	rollInputBlock.MouseButton1Click:Connect(function() if canTapToClaim and (not rollRunning) and (not awaitingRollResult) then closeRollOverlay() end end)
	rollCloseBtn.MouseButton1Click:Connect(function() if rollRunning or awaitingRollResult then return end; awaitingRollResult = false; rollRunning = false; closeRollOverlay() end)

