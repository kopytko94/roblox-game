local MAX_PRESTIGE = 20

function openPresPopup()
	local spMagnetLv = localData.spUpgrades and (localData.spUpgrades["sp_mult1"] or 0) or 0
	local spMult = 1 + spMagnetLv * 0.20
	local baseSP = math.floor((localData.prestige or 0) / 3) + 1
	local spPreview = math.max(1, math.floor(baseSP * spMult))
	local spAfter   = (localData.starPoints or 0) + spPreview
	presPopupInfo.Text = "You earn: +"..spPreview.." ⭐ Star Points\nTotal SP after: "..spAfter.."  ("..spBonusPreview(spAfter).." mult)\n\nYou LOSE:\n  All clicks & upgrades\n\nPets & SP upgrades are SAFE."
	presPopup.Visible=true; presPopup.BackgroundTransparency=0; presDimmer.Visible=true
end

PresUI.btn.MouseButton1Click:Connect(function()
	if (localData.prestige or 0) >= MAX_PRESTIGE then return end
	local req = 1000000 * (10 ^ (localData.prestige or 0))
	if localData.totalClicks >= req then openPresPopup() end
end)

presConfirmBtn.MouseButton1Click:Connect(function()
	tw(presPopup, MED, {BackgroundTransparency=1}):Play(); task.delay(0.28, function() presPopup.Visible=false end); presDimmer.Visible = false
	RE_doPrestige:FireServer(); goTo(0)
end)

presCancelBtn.MouseButton1Click:Connect(function() presPopup.Visible = false; presDimmer.Visible = false end)

function updatePrestigeInfo()
	local pres = localData.prestige or 0
	local isMaxed = pres >= MAX_PRESTIGE
	PresUI.levelNum.Text = tostring(pres)
	PresUI.bonusLabel.Text = spBonusPreview(localData.starPoints or 0)

	if isMaxed then
		PresUI.reqLabel.Text = "MAX LEVEL"; PresUI.reqLabel.TextColor3 = C.gold; PresUI.reqStroke.Color = C.gold; PresUI.reqStroke.Transparency = 0.1
		PresUI.btn.Text = "MAX LEVEL"; PresUI.btn.Active = false; tw(PresUI.btn, FAST, {BackgroundColor3 = Color3.fromRGB(40,30,55)}):Play()
		return
	end

	PresUI.btn.Text = "PRESTIGE NOW!"; PresUI.btn.Active = true
	local req = 1000000 * (10 ^ pres); local can = localData.totalClicks >= req

	if can then
		PresUI.reqLabel.Text = "READY!"; PresUI.reqLabel.TextColor3 = C.green; PresUI.reqStroke.Color = C.green; PresUI.reqStroke.Transparency = 0.1
		if not PresUI.hovered then tw(PresUI.btn, FAST, {BackgroundColor3 = C.purpleDim}):Play() end
	else
		local missing = req - localData.totalClicks
		PresUI.reqLabel.Text = fmt(missing).." more"; PresUI.reqLabel.TextColor3 = C.red; PresUI.reqStroke.Color = C.red; PresUI.reqStroke.Transparency = 0.3
		if not PresUI.hovered then tw(PresUI.btn, FAST, {BackgroundColor3 = Color3.fromRGB(40,30,55)}):Play() end
	end
end

