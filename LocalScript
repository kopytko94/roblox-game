local function setNavActive(idx)
	for i, b in ipairs(navBtns) do
		local isActive = (NAV_TABS[i].screen == idx)
		local col = isActive and Color3.fromRGB(255, 232, 170) or C.grey
		tw(navIndicators[i], MED, {BackgroundTransparency = isActive and 0 or 1}):Play()
		if navLabels[i] then
			tw(navLabels[i].icon, MED, {TextColor3=col}):Play()
			if navLabels[i].iconImg then tw(navLabels[i].iconImg, MED, {ImageColor3=col}):Play() end
			tw(navLabels[i].text, MED, {TextColor3=col}):Play()
		end
		if isActive then b.BackgroundTransparency = 0; b.BackgroundColor3 = Color3.fromRGB(40, 28, 85)
		else b.BackgroundTransparency = 1; b.BackgroundColor3 = Color3.fromRGB(40, 28, 85) end
	end
end

for i, tab in ipairs(NAV_TABS) do
	local b = navBtns[i]
	b.MouseEnter:Connect(function()
		if tab.screen ~= currentScreen then b.BackgroundColor3 = Color3.fromRGB(40, 28, 85); b.BackgroundTransparency = 0 end
	end)
	b.MouseLeave:Connect(function()
		if tab.screen ~= currentScreen then b.BackgroundTransparency = 1 end
	end)
end

local function goTo(idx)
	if transitioning or idx==currentScreen then return end
	transitioning = true; currentScreen = idx
	tw(CONTAINER, SLIDE, {Position=SCREEN_POS[idx]}):Play()
	setNavActive(idx)
	task.delay(0.56, function() transitioning=false end)
end

