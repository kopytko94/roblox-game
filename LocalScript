local function getPetInfo(petId)
	if type(petId) ~= "string" then return nil end
	local isGolden = string.sub(petId, 1, 7) == "golden_"
	local baseId = isGolden and string.sub(petId, 8) or petId
	local pd = PET_DATA[baseId]; if not pd then return nil end
	return {
		id = petId,
		baseId = baseId,
		isGolden = isGolden,
		name = isGolden and ("Golden " .. pd.name) or pd.name,
		emoji = pd.emoji,
		rarity = pd.rarity,
		multiplier = isGolden and (pd.multiplier * 2) or pd.multiplier
	}
end

