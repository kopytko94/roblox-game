local lastMouseX, lastMouseY = 0, 0
clickBtn.MouseMoved:Connect(function(x, y)
	local abs = S_MAIN.AbsolutePosition; local sz  = S_MAIN.AbsoluteSize
	local cx = abs.X + sz.X * BTN_CX; local cy = abs.Y + sz.Y * BTN_CY + BTN_OY
	local dx = x - cx; local dy = y - cy; local dist = math.sqrt(dx*dx + dy*dy)
	local r = BTN_SIZE / 2
	if dist > r then dx = dx / dist * r; dy = dy / dist * r end
	lastMouseX = dx; lastMouseY = dy
end)

local FLOAT_POOL_SIZE = 6
local _floatPool = {}
for i = 1, FLOAT_POOL_SIZE do
	local lbp = lbl(S_MAIN, {Size=UDim2.new(0,180,0,44), Position=UDim2.new(BTN_CX,-90,BTN_CY,BTN_OY-20), Text="+0", TextColor3=C.gold, TextSize=30, Font=Enum.Font.Bangers, ZIndex=10, TextTransparency=1})
	local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(0,0,0); st.Thickness = 2; st.Transparency = 1; st.Parent = lbp
	_floatPool[i] = {label = lbp, stroke = st, y = 0, alpha = 1, active = false, ox = 0}
end
local _floatPoolIdx = 0

local function floatText(val, isCrit)
	_floatPoolIdx = (_floatPoolIdx % FLOAT_POOL_SIZE) + 1
	local slot = _floatPool[_floatPoolIdx]
	local ox = lastMouseX + math.random(-28, 28)
	slot.ox = ox; slot.y = lastMouseY - 20; slot.alpha = 0; slot.active = true
	local textCol = isCrit and Color3.fromRGB(255,80,80) or C.gold
	local size = isCrit and 34 or 30
	slot.label.Text = "+"..fmtPrecise(val); slot.label.TextColor3 = textCol; slot.label.TextSize = size; slot.label.TextTransparency = 0
	slot.label.Position = UDim2.new(BTN_CX, ox - 90, BTN_CY, BTN_OY + slot.y); slot.stroke.Transparency = 0
end

