RunService.Heartbeat:Connect(function(dt)
	if _G._autoClickerActive then
		_G._autoClickAccum = (_G._autoClickAccum or 0) + dt
		local AUTO_INTERVAL = 1 / 3
		while _G._autoClickAccum >= AUTO_INTERVAL do
			_G._autoClickAccum -= AUTO_INTERVAL
			local now = tick()
			if now - lastSqueezeTime >= 0.066 then
				lastSqueezeTime = now
				tw(clickBtn, FAST, {Size=UDim2.new(0,BTN_SIZE-39,0,BTN_SIZE-39), Position=UDim2.new(BTN_CX,-(BTN_SIZE-39)/2,BTN_CY,BTN_OY-(BTN_SIZE-39)/2)}):Play()
				tw(ring1, FAST, {BackgroundTransparency=0.45}):Play()
				task.delay(0.05, function() tw(clickBtn, BACK, {Size=UDim2.new(0,BTN_SIZE,0,BTN_SIZE), Position=UDim2.new(BTN_CX,-BTN_SIZE/2,BTN_CY,BTN_OY-BTN_SIZE/2)}):Play(); tw(ring1, MED, {BackgroundTransparency=0.7}):Play() end)
			end
			doClickVisual(true)
			if now - lastClickSent >= CLICK_COOLDOWN then lastClickSent = now; RE_onClick:FireServer(1) else pendingClicks += 1 end
		end
	end

	for _, slot in ipairs(_floatPool) do
		if slot.active then
			slot.y -= dt * 110; slot.alpha = math.min(1, slot.alpha + dt * 1.6)
			slot.label.Position = UDim2.new(BTN_CX, slot.ox - 90, BTN_CY, BTN_OY + slot.y)
			slot.label.TextTransparency = slot.alpha; slot.stroke.Transparency = slot.alpha
			if slot.alpha >= 1 then slot.active = false end
		end
	end

	if pendingClicks > 0 then
		local now = tick()
		if now - lastClickSent >= CLICK_COOLDOWN then lastClickSent = now; local batch = math.min(pendingClicks, 45); pendingClicks -= batch; RE_onClick:FireServer(batch) end
	end

	local autoCPS = localData.clicksPerSecond or 0
	if autoCPS > 0 then displayedClicks += autoCPS * dt end

	if currentScreen == 4 then
		achRefreshAccum = (achRefreshAccum or 0) + dt
		if achRefreshAccum >= 0.25 then achRefreshAccum = 0; refreshAchievements() end
	end

	if not headerShowingSP then
		headerClickLabel.Text = fmt(displayedClicks); local totalCPS = autoCPS + getManualCPS(); headerCPSLabel.Text = "/s: " .. fmt(totalCPS)
	end
	EggUI.clickLabel.Text = fmt(displayedClicks)

	-- ¦¦ AKTUALIZACJA NEXT GOAL ¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦¦
	if _G.nextGoalName then
		renderNextGoal()
	end

	for id, ui in pairs(upgradeBtns) do
		if ui.hovered then continue end
		local lv = localData.upgrades[id] or 0
		if lv < ui.upg.maxLevel then
			local cost = getUpgradeCost(ui.upg); local canAfford = displayedClicks >= cost
			local targetBg = canAfford and C.gold or Color3.fromRGB(70,55,10); local targetText = canAfford and Color3.fromRGB(0,0,0) or C.grey
			if ui.buyBtn.BackgroundColor3 ~= targetBg then ui.buyBtn.BackgroundColor3 = targetBg; ui.buyBtn.TextColor3 = targetText end
		end
	end
end)

