			openRollIntro(eggNum); awaitingRollResult = true; pendingEggNum = eggNum; rollRequestToken += 1; local token = rollRequestToken
			task.delay(ROLL_REQUEST_TIMEOUT, function() if awaitingRollResult and rollRequestToken == token then awaitingRollResult = false; pendingEggNum = nil; rollRunning = false; closeRollOverlay(); showRollFailureToast("Roll request timed out. Try again.") end end)
			RE_rollEgg:FireServer(eggNum)
		end)
	end
end

