			for j, s in ipairs(LOAD_STEPS) do if s == step then nextIdx = j+1 break end end
			local waitTime = nextIdx and LOAD_STEPS[nextIdx] and (LOAD_STEPS[nextIdx].t - step.t) or 1.0
			task.wait(waitTime)
		end
	end)

	local _loadTimeDone = false
	task.delay(LOAD_MIN_TIME, function()
		_loadTimeDone = true
		if _loadIconsDone and _loadSyncDone and not _loadRevealed then task.spawn(tryRevealUI) end
	end)

	tryRevealUI = function()
		if _loadRevealed then return end
		if not (_loadIconsDone and _loadSyncDone and _loadTimeDone) then return end
		_loadRevealed = true
		statusLabel.Text = "Done! Entering game..."
		TweenService:Create(loadBarFill, TweenInfo.new(0.3), {Size=UDim2.new(1,0,1,0)}):Play()
		task.wait(0.4)
		CONTAINER.Visible = true
		navBar.Visible = true
		TweenService:Create(loadBg, TweenInfo.new(0.55, Enum.EasingStyle.Quad), {BackgroundTransparency=1}):Play()
		task.delay(0.6, function() loadGui:Destroy() end)
	end

	_G._onIconsLoaded = function()
		_loadIconsDone = true
		task.spawn(tryRevealUI)
	end

	task.delay(13, function()
		_loadIconsDone = true; _loadSyncDone = true; _loadTimeDone = true
		task.spawn(tryRevealUI)
	end)
end

