		eggShadow.Position = basePose.shadowPos; eggGlowRing.Position = basePose.ringPos; eggRevealImg.Position = basePose.emojiPos; eggCrackA.Position = basePose.crackAPos; eggCrackB.Position = basePose.crackBPos

		local elapsed, popDur = 0, 0.16
		tw(eggRevealImg, TweenInfo.new(popDur * 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 136, 0, 136)}):Play()
		tw(eggGlowRing, TweenInfo.new(popDur * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 188, 0, 188), BackgroundTransparency = 0.72}):Play()
		tw(eggShadow, TweenInfo.new(popDur * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 206, 0, 48), BackgroundTransparency = 0.48}):Play()
		task.wait(popDur * 0.6); elapsed += popDur * 0.6; if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end

		tw(eggRevealImg, TweenInfo.new(popDur * 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(0, 118, 0, 118)}):Play()
		tw(eggGlowRing, TweenInfo.new(popDur * 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(0, 170, 0, 170)}):Play()
		task.wait(popDur * 0.4); elapsed += popDur * 0.4; if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end

		local shakeDur = 0.18 + math.clamp((fx.shakeAmp - 7) * 0.012, 0, 0.22); local shakeSteps = math.max(4, math.floor(shakeDur / 0.04)); local stepDur = shakeDur / shakeSteps
		for i = 1, shakeSteps do
			if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end
			local progress = (i - 1) / math.max(1, shakeSteps - 1); local amp = fx.shakeAmp * (1 - progress * 0.62)
			local dx = math.floor(((i % 2 == 0) and -1 or 1) * amp); local dy = math.floor(math.sin(i * 1.6) * amp * 0.28)
			tweenEggOffset(dx, dy, stepDur, Enum.EasingStyle.Sine, Enum.EasingDirection.Out); task.wait(stepDur); elapsed += stepDur
		end
		if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end
		tweenEggOffset(0, 0, 0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out); task.wait(0.05); elapsed += 0.05; if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end

