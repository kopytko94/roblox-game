local function getPitySnapshot()
	local leg = type(localData.pityLeg) == "table" and localData.pityLeg or {0,0,0}
	local myth = type(localData.pityMythic) == "table" and localData.pityMythic or {0,0,0}
	local best = nil
	for eggNum = 1, 3 do
		local l = math.max(0, math.floor(asNumber(leg[eggNum]) or 0))
		local m = math.max(0, math.floor(asNumber(myth[eggNum]) or 0))
		local legRemaining = math.max(0, 30 - l)
		local mythRemaining = math.max(0, 100 - m)
		local legProgress = math.clamp(l / 30, 0, 1)
		local mythProgress = math.clamp(m / 100, 0, 1)
		local nearScore = math.max(legProgress, mythProgress)
		if legRemaining > 0 and (not best or legRemaining < best.remaining or (legRemaining == best.remaining and nearScore > best.score)) then
			best = {
				eggNum = eggNum,
				mode = "Legendary",
				remaining = legRemaining,
				threshold = 30,
				score = nearScore,
				progress = legProgress,
				text = string.format("Egg %d • Legendary pity %d/30", eggNum, l),
			}
		end
		if mythRemaining > 0 and (not best or mythRemaining < best.remaining or (mythRemaining == best.remaining and mythProgress > best.score)) then
			best = {
				eggNum = eggNum,
				mode = "Mythic",
				remaining = mythRemaining,
				threshold = 100,
				score = mythProgress,
				progress = mythProgress,
				text = string.format("Egg %d • Mythic pity %d/100", eggNum, m),
			}
		end
	end
	return best
end

local function getUpgradeScore(upg)
	local score = (upg.cpc or 0) * 1.0 + (upg.cps or 0) * 1.45 + (upg.mult or 0) * 7.5
	return math.max(score, 1)
end

local function buildNextGoalSnapshot()
	local currentClicks = math.max(0, math.floor(asNumber(displayedClicks) or 0))
	local totalClicks = math.max(0, math.floor(asNumber(localData.totalClicks) or 0))
	local prestige = math.max(0, math.floor(asNumber(localData.prestige) or 0))
	local presReq = getPrestigeRequirement(prestige)
	local isMaxPrestige = prestige >= MAX_PRESTIGE
	local canPrestige = (not isMaxPrestige) and totalClicks >= presReq
	local prestigeProgress = (isMaxPrestige and 1) or math.clamp(totalClicks / presReq, 0, 1)
	local prestigeAway = math.max(0, presReq - totalClicks)
	local prestigeSoon = (not isMaxPrestige) and prestigeProgress >= 0.85

	local bestAffordable, bestSoonest
	for _, upg in ipairs(UPGRADE_DISPLAY) do
		local lv = localData.upgrades[upg.id] or 0
		if lv < upg.maxLevel then
			local cost = getUpgradeCost(upg)
			local progress = (cost > 0) and math.clamp(currentClicks / cost, 0, 1) or 0
			local score = getUpgradeScore(upg)
			local cand = {
				type = "UPGRADE",
				name = upg.name,
				cost = cost,
				progress = progress,
				away = fmt(math.max(0, cost - currentClicks)) .. " clicks away",
				detail = string.format("+%.1f value | Lv %d/%d", score, lv, upg.maxLevel),
				score = score,
				canAfford = cost <= currentClicks,
			}
			if not bestSoonest or cost < bestSoonest.cost or (cost == bestSoonest.cost and progress > bestSoonest.progress) then
				bestSoonest = cand
			end
			if cand.canAfford and (not bestAffordable or cand.score > bestAffordable.score or (cand.score == bestAffordable.score and cand.cost < bestAffordable.cost)) then
				bestAffordable = cand
			end
		end
	end

	local pity = getPitySnapshot()
	local pityGoal = nil
	if pity then
		local meaningful = (pity.mode == "Legendary" and pity.remaining <= 10) or (pity.mode == "Mythic" and pity.remaining <= 20)
		if meaningful then
			pityGoal = {
				type = "PITY",
				name = string.format("Hatch Egg %d", pity.eggNum),
				cost = 0,
				progress = pity.progress,
				away = string.format("%d hatch%s away", pity.remaining, pity.remaining == 1 and "" or "es"),
				detail = pity.text,
				score = 100 - pity.remaining,
				canAfford = true,
			}
		end
	end

	local goal = nil
	if canPrestige then
		goal = {
			type = "PRESTIGE",
			name = "Prestige " .. (prestige + 1),
			progress = 1,
			away = "Ready to cash out now",
			detail = string.format("Spend %s total clicks for %d SP", fmt(presReq), math.max(1, math.floor(prestige / 3) + 1)),
			score = 999,
		}
	elseif prestigeSoon then
		goal = {
			type = "PRESTIGE",
			name = "Prestige " .. (prestige + 1),
			progress = prestigeProgress,
			away = fmt(prestigeAway) .. " total clicks away",
			detail = string.format("Cash out for +%d SP", math.max(1, math.floor(prestige / 3) + 1)),
			score = prestigeProgress + 0.5,
		}
	elseif bestAffordable then
		goal = bestAffordable
	elseif pityGoal and (not bestSoonest or pityGoal.progress >= math.max(0.5, bestSoonest.progress - 0.15)) then
		goal = pityGoal
	else
		goal = bestSoonest or {
			type = "PRESTIGE",
			name = "Prestige " .. (prestige + 1),
			progress = prestigeProgress,
			away = fmt(prestigeAway) .. " total clicks away",
			detail = string.format("Cash out for +%d SP", math.max(1, math.floor(prestige / 3) + 1)),
			score = prestigeProgress,
		}
	end

	if goal and goal.type == "UPGRADE" and pityGoal and goal.progress < 1 then
		goal.detail = goal.detail .. " | " .. pityGoal.detail
	elseif goal and goal.type == "PRESTIGE" and pityGoal then
		goal.detail = goal.detail .. " | " .. pityGoal.detail
	end

	return goal, { prestigeProgress = prestigeProgress, prestigeAway = prestigeAway, prestige = prestige, presReq = presReq, isMaxPrestige = isMaxPrestige, pity = pity }
end

local lastNextGoalKey  = nil
local lastNextGoalFill = -1

local GOAL_TYPE_COLORS = {
	UPGRADE  = Color3.fromRGB(0, 220, 255),
	PRESTIGE = Color3.fromRGB(160, 60, 255),
	PITY     = Color3.fromRGB(255, 210, 0),
}
local GOAL_TYPE_LABELS = {
	UPGRADE  = "UPGRADE",
	PRESTIGE = "PRESTIGE",
	PITY     = "PITY",
}

local function fmtETA(seconds)
	if seconds <= 0 then return "⚡ gotowe!" end
	local s = math.ceil(seconds)
	if s < 60   then return string.format("⏱ ~%ds", s) end
	if s < 3600 then return string.format("⏱ ~%dm %ds", math.floor(s / 60), s % 60) end
	return string.format("⏱ ~%dh %dm", math.floor(s / 3600), math.floor((s % 3600) / 60))
end

local function renderNextGoal()
	if not _G.nextGoalName then return end
	local goal, meta = buildNextGoalSnapshot()
	if not goal then return end

	local fill    = math.clamp(goal.progress or 0, 0, 1)
	local gType   = goal.type or "UPGRADE"
	local accentC = GOAL_TYPE_COLORS[gType] or C.cyan

	-- Aktualizuj tylko gdy coś się zmieniło (oszczędność)
	local goalKey    = (gType or "") .. "|" .. (goal.name or "") .. "|" .. math.floor(fill * 100)
	local fillChanged = math.abs(fill - lastNextGoalFill) > 0.005

	if goalKey ~= lastNextGoalKey or fillChanged then
		lastNextGoalKey  = goalKey
		lastNextGoalFill = fill

		_G.nextGoalName.Text = goal.name or "???"
		_G.nextGoalAway.Text = goal.away or ""

		if _G.nextGoalTypeBg then
			_G.nextGoalTypeBg.BackgroundColor3 = accentC
		end
		if _G.nextGoalTypeLabel then
			_G.nextGoalTypeLabel.Text = GOAL_TYPE_LABELS[gType] or gType
			_G.nextGoalTypeLabel.TextColor3 = (gType == "PITY")
				and Color3.fromRGB(10, 8, 0)
				or  Color3.fromRGB(0, 0, 0)
		end

		TweenService:Create(
			_G.nextGoalBarFill,
			TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(fill, 0, 1, 0), BackgroundColor3 = accentC }
		):Play()

		if _G.nextGoalPct then
			_G.nextGoalPct.Text = math.floor(fill * 100) .. "%"
		end

		if _G.nextGoalDetail then
			_G.nextGoalDetail.Text = goal.detail or ""
		end
	end

	-- ETA — przeliczamy co klatkę bo rate się zmienia
	if _G.nextGoalETA then
		local autoCPS   = localData.clicksPerSecond or 0
		local manualCPS = getManualCPS()
		local totalRate = autoCPS + manualCPS
		local etaText   = ""

		if gType == "UPGRADE" and goal.cost and goal.cost > 0 then
			local needed = math.max(0, goal.cost - displayedClicks)
			if needed <= 0 then
				etaText = "⚡ stać cię — kup teraz!"
				_G.nextGoalETA.TextColor3 = C.green
			elseif totalRate > 0 then
				etaText = fmtETA(needed / totalRate)
				_G.nextGoalETA.TextColor3 = Color3.fromRGB(80, 200, 255)
			else
				etaText = "⏱ klikaj żeby zarobić"
				_G.nextGoalETA.TextColor3 = C.grey
			end
		elseif gType == "PRESTIGE" then
			local needed = math.max(0, meta.prestigeAway)
			if needed <= 0 then
				etaText = "⚡ PRESTIGE dostępny!"
				_G.nextGoalETA.TextColor3 = C.purple
			elseif totalRate > 0 then
				etaText = fmtETA(needed / totalRate)
				_G.nextGoalETA.TextColor3 = Color3.fromRGB(200, 150, 255)
			else
				etaText = "⏱ klikaj żeby zarobić"
				_G.nextGoalETA.TextColor3 = C.grey
			end
		elseif gType == "PITY" then
			etaText = "🎲 rolluj jajka!"
			_G.nextGoalETA.TextColor3 = C.gold
		end
		_G.nextGoalETA.Text = etaText
	end

	-- Linia prestige
	if _G.nextGoalPres then
		local spMagnetLv  = (localData.spUpgrades and localData.spUpgrades["sp_mult1"]) or 0
		local spMult      = 1 + spMagnetLv * 0.20
		local baseSP      = math.floor((localData.prestige or 0) / 3) + 1
		local spEarned    = math.max(1, math.floor(baseSP * spMult))
		if meta.isMaxPrestige then
			_G.nextGoalPres.Text      = "Prestige: MAX ✓"
			_G.nextGoalPres.TextColor3 = C.gold
		else
			local pct = math.floor((meta.prestigeProgress or 0) * 100)
			_G.nextGoalPres.TextColor3 = pct >= 85 and C.green or C.gold
			_G.nextGoalPres.Text = string.format(
				"Prestige %d: %d%% → +%d SP",
				(localData.prestige or 0) + 1, pct, spEarned
			)
		end
	end
end

