getEffectiveEggCost = function(baseCost)
	local base = asNumber(baseCost) or 0
	local disc = math.clamp(asNumber(localData.eggDiscount) or 0, 0, 0.45)
	return math.max(1, math.floor(base * (1 - disc)))
end

function refreshAchievements()
	local function getAchProgress(ach)
		if ach.req_lifetime then return math.min(localData.lifetimeClicks or 0, ach.req_lifetime), ach.req_lifetime end
		if ach.req_owned    then return math.min(localData.clicks or 0, ach.req_owned), ach.req_owned end
		if ach.req_clicks   then return math.min(localData.totalClicks or 0, ach.req_clicks), ach.req_clicks end
		if ach.req_prestige then return math.min(localData.prestige or 0, ach.req_prestige), ach.req_prestige end
		if ach.req_pets     then local cnt = math.max(0, #(localData.inventory or {}) - 1); return math.min(cnt, ach.req_pets), ach.req_pets end
		if ach.req_sp       then return math.min(localData.totalSPEarned or 0, ach.req_sp), ach.req_sp end
		if ach.req_streak   then return math.min(localData.dailyStreak or 0, ach.req_streak), ach.req_streak end
		local done = localData.achievements and localData.achievements[ach.id]
		return done and 1 or 0, 1
	end

	local tot_cpc, tot_cps, tot_all, tot_sp, unlocked = 0, 0, 0, 0, 0

	for _, ach in ipairs(ACHIEVEMENT_DISPLAY) do
		local ui = AchUI.cards[ach.id]; if not ui then continue end
		local isUnlocked = localData.achievements and localData.achievements[ach.id]
		local isClaimed  = localData.claimedAchievements and localData.claimedAchievements[ach.id]

		if isClaimed then
			local rw = ach.reward
			if rw:find("CPC") then tot_cpc += tonumber(rw:match("([%d%.]+)")) or 0
			elseif rw:find("CPS") then tot_cps += tonumber(rw:match("([%d%.]+)")) or 0
			elseif rw:find("All") then tot_all += tonumber(rw:match("([%d%.]+)")) or 0
			elseif rw:find("SP") then tot_sp += tonumber(rw:match("([%d%.]+)")) or 0 end
		end

		local cur, maxVal = getAchProgress(ach); local ratio = maxVal > 0 and math.clamp(cur / maxVal, 0, 1) or 0

