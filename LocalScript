DailyUI.refreshModal = function()
	local currentDay = localData.dailyRewardDay or 1
	local now = tick()
	local secsLeft = 0
	if DailyUI.is24hPhase then
		local cdLeft = math.max(0, math.floor(DailyUI.anchorSecs - (now - DailyUI.anchorTick)))
		if cdLeft > 0 then secsLeft = cdLeft
		else
			local cdExpiredAt = DailyUI.anchorTick + DailyUI.anchorSecs
			local sessionElapsed = math.max(0, now - cdExpiredAt)
			secsLeft = math.max(0, math.floor(DailyUI.sessionAnchorSecs - sessionElapsed))
		end
	else
		secsLeft = math.max(0, math.floor(DailyUI.sessionAnchorSecs - (now - DailyUI.sessionAnchorTick)))
	end
	local claimable = (secsLeft == 0)

	for d = 1, 7 do
		local ui = DailyUI.blocks[d]; if not ui then continue end
		ui.claimBtn.Visible = false; ui.countdownLabel.Visible = false; ui.statusLabel.Visible = false; ui.claimedBadge.Visible = false

		if d < currentDay then
			ui.claimedBadge.Visible = true; ui.block.BackgroundColor3 = Color3.fromRGB(10,26,14); ui.blockStroke.Color = C.green; ui.blockStroke.Transparency = 0.3
			if ui.dayWordLbl then ui.dayWordLbl.TextColor3 = C.grey end; if ui.dayNumLbl then ui.dayNumLbl.TextColor3 = C.grey end
			if ui.emojiLbl then ui.emojiLbl.Text = "🎊" end
		elseif d == currentDay then
			ui.block.BackgroundColor3 = Color3.fromRGB(22,17,42); ui.blockStroke.Color = C.gold; ui.blockStroke.Transparency = 0
			if ui.dayWordLbl then ui.dayWordLbl.TextColor3 = C.white end; if ui.dayNumLbl then ui.dayNumLbl.TextColor3 = C.white end
			if ui.emojiLbl then ui.emojiLbl.Text = "🎁" end
			if claimable then ui.claimBtn.Visible = true else
				ui.countdownLabel.Visible = true
				local h = math.floor(secsLeft / 3600); local m = math.floor((secsLeft % 3600) / 60); local s = secsLeft % 60
				ui.countdownLabel.Text = h > 0 and string.format("%d:%02d:%02d", h, m, s) or string.format("%02d:%02d", m, s)
			end
		else
			ui.statusLabel.Visible = true; ui.statusLabel.Text = "🔒 Day " .. d; ui.block.BackgroundColor3 = Color3.fromRGB(14,12,28)
			ui.blockStroke.Color = C.greyDark; ui.blockStroke.Transparency = 0.45
			if ui.dayWordLbl then ui.dayWordLbl.TextColor3 = C.white end; if ui.dayNumLbl then ui.dayNumLbl.TextColor3 = C.white end
			if ui.emojiLbl then ui.emojiLbl.Text = "🎁" end
		end
	end
	if DailyUI.notifBadge then DailyUI.notifBadge.Visible = claimable end
end

