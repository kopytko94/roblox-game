		tw(eggCrackB, TweenInfo.new(fx.crackDur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 6, 0, 86), BackgroundTransparency = 0.14, Rotation = -34}):Play()
		task.wait(fx.crackDur); elapsed += fx.crackDur; if token ~= rollAnimToken or not rollRunning then return nil, nil, nil end

		tw(rollFlashFrame, TweenInfo.new(flashOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
		tw(rollBloomFrame, TweenInfo.new(flashOut * 1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play(); elapsed += flashIn

		local burstCount = fx.burstCount; local whiteBurst = math.max(2, math.floor(burstCount * 0.30)); local shardBurst = math.max(3, math.floor(burstCount * 0.35))
		for i = 1, burstCount do spawnBurstParticle((i % 3 == 0) and C.white or rc, {sizeMin = 5, sizeMax = 14, life = 0.72, distMin = 110, distMax = 310}) end
