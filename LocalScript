local manualClickHistory = {}
local function recordManualClick(earned)
	table.insert(manualClickHistory, {t = tick(), v = earned})
end
local function getManualCPS()
	local now = tick()
	local sum = 0
	local i = 1
	while i <= #manualClickHistory do
		if now - manualClickHistory[i].t > 1 then table.remove(manualClickHistory, i)
		else sum += manualClickHistory[i].v; i += 1 end
	end
	return sum
end

